<Window x:Class="Embasic.Legal.Desktop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Embasic Legal 2.0 Alpha" Width="1160" Height="730"
        MinWidth="900" MinHeight="560" WindowStartupLocation="CenterScreen"
        Background="{DynamicResource BackgroundBrush}"
        Foreground="{DynamicResource TextBrush}">
  <Grid>
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="255"/>
      <ColumnDefinition Width="*"/>
    </Grid.ColumnDefinitions>
    <Border Grid.Column="0" Background="{DynamicResource SurfaceBrush}"
            BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,1,0">
      <DockPanel Margin="14">
        <StackPanel DockPanel.Dock="Top" Margin="0,8,0,16">
          <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
            <Image Source="{StaticResource EmbasicLogo}" Width="55" Height="55" Stretch="Uniform" Margin="0,0,8,0" AutomationProperties.Name="Embasic Legal E-terazi logosu"/>
            <TextBlock Text="EMBASIC LEGAL" VerticalAlignment="Center" FontSize="18" FontWeight="Bold"/>
          </StackPanel>
          <TextBlock Text="Windows Alpha · kaynak doğrulaması bekliyor" Margin="0,7,0,0" TextWrapping="Wrap"/>
        </StackPanel>
        <ScrollViewer VerticalScrollBarVisibility="Auto">
          <ItemsControl ItemsSource="{Binding NavigationItems}">
            <ItemsControl.ItemTemplate>
              <DataTemplate>
                <Button HorizontalContentAlignment="Left"
                        Command="{Binding DataContext.NavigateCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                        CommandParameter="{Binding Key}">
                  <TextBlock Text="{Binding Label}" TextWrapping="Wrap"/>
                </Button>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </ScrollViewer>
      </DockPanel>
    </Border>
    <DockPanel Grid.Column="1" LastChildFill="True">
      <Border DockPanel.Dock="Top" Background="{DynamicResource SurfaceBrush}"
              BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1" Padding="18,12">
        <DockPanel LastChildFill="True">
          <StackPanel Orientation="Horizontal" DockPanel.Dock="Right">
            <Button Click="OnToggleTheme" Content="Açık / Koyu"/>
            <Button Click="OnDetach" Content="Ayrı pencere"/>
          </StackPanel>
          <TextBlock Text="{Binding CurrentTitle}" FontWeight="Bold" FontSize="19"
                     VerticalAlignment="Center"/>
        </DockPanel>
      </Border>
      <Border Margin="24" Padding="20" Background="{DynamicResource SurfaceBrush}"
              BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="12">
        <ContentControl Content="{Binding CurrentPage}"/>
      </Border>
    </DockPanel>
  </Grid>
</Window>
