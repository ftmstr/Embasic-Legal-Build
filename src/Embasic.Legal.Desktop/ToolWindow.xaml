<Window x:Class="Embasic.Legal.Desktop.ToolWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Width="650" Height="650" MinWidth="520" MinHeight="480"
        Background="{DynamicResource BackgroundBrush}"
        Foreground="{DynamicResource TextBrush}">
  <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="18">
    <Border Background="{DynamicResource SurfaceBrush}" Padding="20"
            BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
            CornerRadius="10">
      <ContentControl Content="{Binding}"/>
    </Border>
  </ScrollViewer>
</Window>
