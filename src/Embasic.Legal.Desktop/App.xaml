<Application x:Class="Embasic.Legal.Desktop.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:Embasic.Legal.Desktop.ViewModels"
             StartupUri="MainWindow.xaml">
  <Application.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="Themes/Dark.xaml" />
      </ResourceDictionary.MergedDictionaries>
      <BitmapImage x:Key="EmbasicLogo" UriSource="pack://application:,,,/assets/Embasic_Legal_E_Terazi_Ikon.png" />
      <BooleanToVisibilityConverter x:Key="BooleanVisibility" />
      <Style TargetType="TextBlock">
        <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
      </Style>
      <Style TargetType="TextBox">
        <Setter Property="Padding" Value="8" />
        <Setter Property="Margin" Value="0,4,0,10" />
        <Setter Property="Background" Value="{DynamicResource SurfaceBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
      </Style>
      <Style TargetType="Button">
        <Setter Property="Padding" Value="12,8" />
        <Setter Property="Margin" Value="0,3,7,3" />
        <Setter Property="Background" Value="{DynamicResource SurfaceBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
      </Style>
      <Style TargetType="CheckBox">
        <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
        <Setter Property="Margin" Value="0,5,0,9" />
      </Style>
      <DataTemplate DataType="{x:Type vm:DashboardViewModel}">
        <StackPanel>
          <TextBlock FontSize="27" FontWeight="Bold" Text="Embasic Legal 2.0 — Windows Alpha"/>
          <TextBlock FontSize="15" TextWrapping="Wrap" Margin="0,20,0,0"
                     Text="Gerçek WPF masaüstü uygulaması. İlk geliştirme turunda takvim hesaplama çekirdeği etkinleştirildi."/>
          <TextBlock Margin="0,14,0,0" TextWrapping="Wrap" Text="Mevzuat ve resmî UYAP güneş çizelgesi doğrulanmadı; hukuki üretim NO-GO."/>
        </StackPanel>
      </DataTemplate>
      <DataTemplate DataType="{x:Type vm:CalculatorHubViewModel}">
        <StackPanel>
          <TextBlock FontSize="22" FontWeight="Bold" Text="Adli Hesaplama Merkezi"/>
          <TextBlock Margin="0,13,0,0" TextWrapping="Wrap" Text="Tarih karşılaştırması, tarihe gün/ay/yıl ekleme ve Gece Vakti için sol menüdeki araçları seçin."/>
          <Button Margin="0,13,0,0" HorizontalAlignment="Left"
                  Content="Adli Ceza ve Para Cezası — hesaplamaları aç"
                  Command="{Binding DataContext.NavigateCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                  CommandParameter="penalty"/>
          <TextBlock Margin="0,10,0,0" TextWrapping="Wrap"
                     Text="Ceza oran hesabı, hapis/adlî para tutarı, manuel YDO ve eski TL dönüşümü yeniden eklendi. Sonuçlar matematiksel örnek olup bağlayıcı hukuki karar değildir."/>
        </StackPanel>
      </DataTemplate>
      <DataTemplate DataType="{x:Type vm:PenaltyMoneyViewModel}">
        <ScrollViewer VerticalScrollBarVisibility="Auto" MaxHeight="780">
          <StackPanel MaxWidth="770" HorizontalAlignment="Left">
            <TextBlock FontSize="23" FontWeight="Bold" Text="Adli Ceza ve Para Cezası"/>
            <TextBlock TextWrapping="Wrap" Margin="0,7,0,14"
                       Text="Eski v1.5 hesaplamalarının gerçek C# / WPF karşılığı. Yalnız aritmetik; hüküm, TCK 50/52 dönüştürme izni, 61. madde uygulaması, infaz ve lehe kanun otomatik onaylanmaz."/>
            <TabControl SelectedIndex="{Binding SelectedTab, Mode=TwoWay}">
              <TabItem Header="Ceza oran hesaplama">
                <StackPanel Margin="12" >
                  <TextBlock FontSize="17" FontWeight="Bold" Text="Ceza artırımı / indirimi"/>
                  <TextBlock Text="Yalnız tam gün cinsinden başlangıç süre" Margin="0,8,0,1"/>
                  <TextBox Width="180" HorizontalAlignment="Left" Text="{Binding RatioDays, UpdateSourceTrigger=PropertyChanged}"/>
                  <StackPanel Orientation="Horizontal">
                    <StackPanel Margin="0,0,10,0">
                      <TextBlock Text="Oran payı"/>
                      <TextBox Width="105" Text="{Binding Numerator, UpdateSourceTrigger=PropertyChanged}"/>
                    </StackPanel>
                    <StackPanel>
                      <TextBlock Text="Oran paydası"/>
                      <TextBox Width="105" Text="{Binding Denominator, UpdateSourceTrigger=PropertyChanged}"/>
                    </StackPanel>
                  </StackPanel>
                  <CheckBox Content="İndirim (işaretlenmezse artırım)" IsChecked="{Binding Reduction}"/>
                  <Button HorizontalAlignment="Left" Content="Oransal hesapla"
                          Command="{Binding CalculateRatioCommand}"/>
                  <TextBlock Text="{Binding RatioResult}" TextWrapping="Wrap"
                             FontSize="14" Margin="0,12,0,0"/>
                  <TextBlock TextWrapping="Wrap" Margin="0,12,0,0"
                             Text="Uyarı: Önceki HTML 1 yıl=12 ay, 1 ay=30 gün diye basit dönüştürüyordu. Hukuken yanlış günleştirmeyi önlemek için burada yıl/ay alanları kaldırıldı. Tam gün sayısı manuel doğrulanmalıdır."/>
                </StackPanel>
              </TabItem>
              <TabItem Header="Hapis / para hesabı">
                <StackPanel Margin="12">
                  <TextBlock FontSize="17" FontWeight="Bold" Text="Hapis süresi / adlî para — aritmetik"/>
                  <TextBlock Text="Tam gün sayısı (mahkeme/kanun belirlemesi değildir)" Margin="0,8,0,1"/>
                  <TextBox Width="180" HorizontalAlignment="Left" Text="{Binding FineDays, UpdateSourceTrigger=PropertyChanged}"/>
                  <TextBlock Text="Bir gün karşılığı tutar (TL), manuel" Margin="0,7,0,1"/>
                  <TextBox Width="180" HorizontalAlignment="Left" Text="{Binding DailyAmount, UpdateSourceTrigger=PropertyChanged}"/>
                  <TextBlock Text="Eklenecek diğer tutar (TL), isteğe bağlı" Margin="0,7,0,1"/>
                  <TextBox Width="180" HorizontalAlignment="Left" Text="{Binding AdditionalAmount, UpdateSourceTrigger=PropertyChanged}"/>
                  <TextBlock Text="Suç tarihi (gg.aa.yyyy) — yalnız tarihsel uyarı" Margin="0,7,0,1"/>
                  <TextBox Width="180" HorizontalAlignment="Left" Text="{Binding CrimeDate, UpdateSourceTrigger=PropertyChanged}"/>
                  <Button HorizontalAlignment="Left" Content="Para tutarını matematiksel hesapla"
                          Command="{Binding CalculateFineCommand}"/>
                  <TextBlock Text="{Binding FineResult}" TextWrapping="Wrap" Margin="0,10,0,4"/>
                  <TextBlock Text="{Binding HistoricRateNote}" TextWrapping="Wrap"/>
                  <TextBlock TextWrapping="Wrap" Margin="0,12,0,0"
                             Text="TCK 52/2 1.06.2024 öncesi 20–100 TL, 7499 m.9 ve m.40 ile sonrası 100–500 TL. Bu yalnız norm değişikliği uyarısıdır. TCK 7 lehe kanun, özel suç sınırı, TCK 50 çevrilebilirlik ve mahkeme takdiri ayrıca incelenmelidir."/>
                </StackPanel>
              </TabItem>
              <TabItem Header="YDO / para dönüşümü">
                <StackPanel Margin="12">
                  <TextBlock FontSize="17" FontWeight="Bold" Text="Yeniden değerleme oranı — manuel bileşik matematik"/>
                  <TextBlock Text="Başlangıç TL" Margin="0,8,0,1"/>
                  <TextBox Width="180" HorizontalAlignment="Left" Text="{Binding RevalueBase, UpdateSourceTrigger=PropertyChanged}"/>
                  <TextBlock Text="Yıllık oranlar (%) — noktalı virgülle ayır: 43,93; 25,49"
                             TextWrapping="Wrap" Margin="0,7,0,1"/>
                  <TextBox Width="310" HorizontalAlignment="Left" Text="{Binding RevalueRates, UpdateSourceTrigger=PropertyChanged}"/>
                  <TextBlock Text="Oranların tebliğ/kaynak referansı (manuel, doğrulanmaz)"
                             TextWrapping="Wrap" Margin="0,7,0,1"/>
                  <TextBox Width="410" HorizontalAlignment="Left" MaxLength="180"
                           Text="{Binding RateReference, UpdateSourceTrigger=PropertyChanged}"/>
                  <Button Content="Bileşik tutarı hesapla" HorizontalAlignment="Left"
                          Command="{Binding CalculateRevalueCommand}"/>
                  <TextBlock Text="{Binding RevalueResult}" TextWrapping="Wrap" Margin="0,10,0,10"/>
                  <TextBlock Text="2005 öncesi eski TL (1.000.000 eski TL = 1 TL)" TextWrapping="Wrap"/>
                  <TextBox Width="180" HorizontalAlignment="Left" Text="{Binding OldLira, UpdateSourceTrigger=PropertyChanged}"/>
                  <Button Content="Eski TL'yi TL birimine çevir" HorizontalAlignment="Left"
                          Command="{Binding ConvertOldLiraCommand}"/>
                  <TextBlock TextWrapping="Wrap" Margin="0,8,0,0"
                             Text="YDO oranları otomatik alınmaz ve adlî para cezasına otomatik artırma uygulanmaz. Sonuç hukuki yuvarlama veya mevzuat limiti içermez."/>
                </StackPanel>
              </TabItem>
            </TabControl>
            <Button Content="Açık sekmenin sonuç metnini kopyala" Margin="0,14,0,0"
                    HorizontalAlignment="Left" Command="{Binding CopyResultCommand}"/>
          </StackPanel>
        </ScrollViewer>
      </DataTemplate>
      <DataTemplate DataType="{x:Type vm:DateRangeViewModel}">
        <ScrollViewer VerticalScrollBarVisibility="Auto">
          <StackPanel MaxWidth="640" HorizontalAlignment="Left">
            <TextBlock FontSize="21" FontWeight="Bold" Text="Belirli Tarih / Olay Tarihi"/>
            <TextBlock Margin="0,10,0,2" Text="Olay tarihi (gg.aa.yyyy)"/>
            <TextBox Width="220" HorizontalAlignment="Left" Text="{Binding EventDate, UpdateSourceTrigger=PropertyChanged}"/>
            <TextBlock Text="Belirli tarih (gg.aa.yyyy)"/>
            <TextBox Width="220" HorizontalAlignment="Left" Text="{Binding ReferenceDate, UpdateSourceTrigger=PropertyChanged}"/>
            <TextBlock Margin="0,6,0,2" Text="İsteğe bağlı tarih kaydırma — önce yıl, sonra ay, sonra gün"/>
            <StackPanel Orientation="Horizontal">
              <StackPanel Margin="0,0,14,0"><TextBlock Text="Yıl"/><TextBox Width="85" Text="{Binding Years, UpdateSourceTrigger=PropertyChanged}"/></StackPanel>
              <StackPanel Margin="0,0,14,0"><TextBlock Text="Ay"/><TextBox Width="85" Text="{Binding Months, UpdateSourceTrigger=PropertyChanged}"/></StackPanel>
              <StackPanel><TextBlock Text="Gün"/><TextBox Width="85" Text="{Binding Days, UpdateSourceTrigger=PropertyChanged}"/></StackPanel>
            </StackPanel>
            <CheckBox Content="Belirli tarihe uygula (işaretli değilse olay tarihine)" IsChecked="{Binding ApplyToReference}"/>
            <CheckBox Content="Ekle yerine çıkar" IsChecked="{Binding Subtract}"/>
            <StackPanel Orientation="Horizontal"><Button Width="135" Content="Hesapla" Command="{Binding CalculateCommand}"/><Button Width="135" Content="Sonucu kopyala" Command="{Binding CopyCommand}"/></StackPanel>
            <TextBlock Margin="0,20,0,0" TextWrapping="Wrap" FontSize="15" Text="{Binding Result}"/>
            <TextBlock Margin="0,15,0,0" TextWrapping="Wrap" Text="Takvimsel hesap. Kanuni süre veya lehe kanun değerlendirmesi değildir."/>
          </StackPanel>
        </ScrollViewer>
      </DataTemplate>
      <DataTemplate DataType="{x:Type vm:DateShiftViewModel}">
        <ScrollViewer VerticalScrollBarVisibility="Auto">
          <StackPanel MaxWidth="640" HorizontalAlignment="Left">
            <TextBlock FontSize="21" FontWeight="Bold" Text="Tarihe Gün / Ay / Yıl Ekle–Çıkar"/>
            <TextBlock Margin="0,12,0,2" Text="Başlangıç tarihi (gg.aa.yyyy)"/>
            <TextBox Width="210" HorizontalAlignment="Left" Text="{Binding Date, UpdateSourceTrigger=PropertyChanged}"/>
            <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
              <StackPanel Margin="0,0,14,0"><TextBlock Text="Yıl"/><TextBox Width="85" Text="{Binding Years, UpdateSourceTrigger=PropertyChanged}"/></StackPanel>
              <StackPanel Margin="0,0,14,0"><TextBlock Text="Ay"/><TextBox Width="85" Text="{Binding Months, UpdateSourceTrigger=PropertyChanged}"/></StackPanel>
              <StackPanel><TextBlock Text="Gün"/><TextBox Width="85" Text="{Binding Days, UpdateSourceTrigger=PropertyChanged}"/></StackPanel>
            </StackPanel>
            <CheckBox Content="Ekle yerine çıkar" IsChecked="{Binding Subtract}"/>
            <Button Width="135" HorizontalAlignment="Left" Content="Hesapla" Command="{Binding CalculateCommand}"/>
            <TextBlock Margin="0,18,0,0" FontSize="15" TextWrapping="Wrap" Text="{Binding Result}"/>
            <TextBlock Margin="0,15,0,0" TextWrapping="Wrap" Text="Sıra: yıl → ay → gün. Ay sonu .NET takvim kurallarıyla kırpılır; bu hukuki süre hesabı değildir."/>
          </StackPanel>
        </ScrollViewer>
      </DataTemplate>
      <DataTemplate DataType="{x:Type vm:NightViewModel}">
        <StackPanel>
          <TextBlock FontSize="21" FontWeight="Bold" Text="Gece Vakti"/>
          <TextBlock Margin="0,15,0,2" Text="İl"/>
          <ComboBox Width="225" HorizontalAlignment="Left" Margin="0,4,0,10" ItemsSource="{Binding Provinces}" SelectedItem="{Binding Province}"/>
          <TextBlock Text="Olay tarihi (gg.aa.yyyy)"/>
          <TextBox Width="225" HorizontalAlignment="Left" Text="{Binding Date, UpdateSourceTrigger=PropertyChanged}"/>
          <TextBlock Text="Olay saati (isteğe bağlı)"/>
          <TextBox Width="225" HorizontalAlignment="Left" Text="{Binding EventTime, UpdateSourceTrigger=PropertyChanged}"/>
          <Button Content="Resmî kaynağı denetle" Width="190" HorizontalAlignment="Left" Command="{Binding CheckCommand}"/>
          <TextBlock Margin="0,18,0,0" TextWrapping="Wrap" FontSize="15" Text="{Binding Result}"/>
          <TextBlock Margin="0,15,0,0" TextWrapping="Wrap" Text="Bu Alpha sürüm, resmî UYAP çizelgesi olmadan güneş saati veya TCK gece vakti üretmez."/>
        </StackPanel>
      </DataTemplate>
      <DataTemplate DataType="{x:Type vm:LegislationViewModel}">
        <StackPanel>
          <TextBlock FontSize="21" FontWeight="Bold" Text="Mevzuat — Kaynak Dizini"/>
          <TextBlock Margin="0,10,0,14" TextWrapping="Wrap" Text="15 düzenleme yalnızca ad ve numara olarak kaydedilmiştir. Resmî tam metin doğrulanmadı. Madde araması/not baloncuğu sonraki turda geliştirilecektir."/>
          <ListBox Height="260" Width="720" HorizontalAlignment="Left" ItemsSource="{Binding Laws}"
                   SelectedItem="{Binding SelectedLaw, Mode=TwoWay}" DisplayMemberPath="DisplayName"/>
          <TextBlock Margin="0,10,0,4" TextWrapping="Wrap"
                     Text="Resmî madde metni doğrulanmadı: hiçbir maddeye gerçek mevzuat etiketiyle not bağlanmaz." />
          <Button Width="265" HorizontalAlignment="Left" Content="Yerel PDF adayı ekle (5237/5271)"
                  Command="{Binding ImportPdfCommand}"/>
          <TextBlock Margin="0,8,0,0" TextWrapping="Wrap" Text="{Binding ReceiptStatus}" />

        </StackPanel>
      </DataTemplate>
      <DataTemplate DataType="{x:Type vm:NoteSandboxViewModel}">
        <StackPanel MaxWidth="750" HorizontalAlignment="Left">
          <TextBlock FontSize="22" FontWeight="Bold" Text="Madde Notu — WPF Deneme Alanı"/>
          <TextBlock Margin="0,10,0,14" TextWrapping="Wrap"
                     Text="SENTETİK ÖRNEK: Bu satır gerçek bir kanun maddesi değildir. Resmî mevzuat metinleri onaylanmadığı için yalnızca not baloncuğu/sticker kullanıcı deneyimi denenebilir. Gerçek soruşturma bilgisi girmeyin." />
          <TextBlock Margin="0,2,0,7" FontWeight="Bold" Text="Şifreli kasa — en az 12 karakter parola"/>
          <PasswordBox x:Name="VaultPassword" Width="330" Height="32" HorizontalAlignment="Left"
                       AutomationProperties.Name="Şifreli kasa parolası (ekranda gizlenir)"/>
          <WrapPanel Margin="0,7,0,10">
            <Button Content="Kasayı aç / oluştur" Command="{Binding UnlockCommand}"
                    CommandParameter="{Binding ElementName=VaultPassword}"/>
            <Button Content="Yedeği geri yükle (kilitliyken)" Command="{Binding RestoreCommand}"
                    CommandParameter="{Binding ElementName=VaultPassword}"/>
            <Button Content="Kasayı kilitle" Command="{Binding LockCommand}"/>
            <Button Content="Şifreli yedeği dışa aktar" Command="{Binding ExportBackupCommand}"/>
          </WrapPanel>
          <TextBlock Margin="0,0,0,10" TextWrapping="Wrap" FontSize="11"
                     Text="Parolanızı kaybederseniz kasa kurtarılamaz. Eski TUR003 düz metin notları ayrı tutulur; otomatik taşınmaz. Gizli soruşturma verisi GİRMEYİN."/>
          <Border Margin="0,8,0,10" Padding="12" BorderThickness="1"
                  BorderBrush="{DynamicResource BorderBrush}"
                  Background="{DynamicResource BackgroundBrush}" CornerRadius="8">
            <StackPanel>
              <TextBlock FontWeight="Bold" Text="Eski notları şifreli kasaya aktar (isteğe bağlı)"/>
              <TextBlock Margin="0,4,0,7" TextWrapping="Wrap" FontSize="11"
                         Text="Ön inceleme salt okunurdur. Aktarım için önce kasa açık, sonra onay kutusu ve ikinci onay gerekir. Eski veritabanı/yedekler düz metin olarak kalır."/>
              <Button Content="Eski notları ön incele" HorizontalAlignment="Left"
                      Command="{Binding PreviewLegacyCommand}"/>
              <CheckBox Content="Şifreli kasaya aktarmayı açıkça onaylıyorum"
                        IsChecked="{Binding MigrationConsent, Mode=TwoWay}"/>
              <Button Content="Onaylı aktarımı başlat" HorizontalAlignment="Left"
                      Command="{Binding ApplyLegacyCommand}"/>
              <TextBlock Margin="0,7,0,0" TextWrapping="Wrap"
                         Text="{Binding MigrationStatus}"/>
            </StackPanel>
          </Border>
          <Border BorderThickness="1" BorderBrush="{DynamicResource BorderBrush}"
                  CornerRadius="8" Padding="12" Background="{DynamicResource BackgroundBrush}">
            <StackPanel Orientation="Horizontal">
              <Button x:Name="ExampleArticleButton" Content="ÖRNEK MADDE — not baloncuğunu aç"
                      Command="{Binding ToggleCommand}" ToolTip="Sentetik not örneğini aç/kapat"/>
              <TextBlock Text="📝" Margin="6,3,0,0" FontSize="19"
                         ToolTip="Bu örnek maddede kayıtlı not var"
                         AutomationProperties.Name="Bu örnek maddede not var"
                         Visibility="{Binding HasNote, Converter={StaticResource BooleanVisibility}}"/>
            </StackPanel>
          </Border>
          <Popup IsOpen="{Binding IsOpen, Mode=TwoWay}"
                 PlacementTarget="{Binding ElementName=ExampleArticleButton}"
                 Placement="Bottom" StaysOpen="True" AllowsTransparency="True"
                 PopupAnimation="Fade">
            <Border Width="{Binding EditorWidth}" Height="{Binding EditorHeight}" Padding="12"
                    CornerRadius="10" BorderThickness="2"
                    BorderBrush="{DynamicResource AccentBrush}"
                    Background="{DynamicResource SurfaceBrush}">
              <DockPanel LastChildFill="True">
                <StackPanel DockPanel.Dock="Top">
                  <TextBlock FontWeight="Bold" FontSize="16" Text="📝 Sentetik madde notu"/>
                  <TextBlock Margin="0,5,0,7" FontSize="11" TextWrapping="Wrap"
                             Text="Yalnız arayüz testi — gerçek kanun maddesi veya gizli dosya değil."/>
                </StackPanel>
                <StackPanel DockPanel.Dock="Bottom" Margin="0,8,0,0">
                  <WrapPanel>
                    <Button Content="Kaydet" Command="{Binding SaveCommand}"/>
                    <Button Content="Genişlet / Küçült" Command="{Binding ExpandCommand}"/>
                    <Button Content="Sil" Command="{Binding DeleteCommand}"/>
                    <Button Content="Kapat" Command="{Binding CloseCommand}"/>
                  </WrapPanel>
                  <TextBlock Margin="0,3,0,0" FontSize="11" TextWrapping="Wrap" Text="{Binding Status}"/>
                </StackPanel>
                <TextBox Text="{Binding Draft, UpdateSourceTrigger=PropertyChanged}"
                         AcceptsReturn="True" TextWrapping="Wrap"
                         VerticalScrollBarVisibility="Auto"
                         AutomationProperties.Name="Madde notu yazma alanı" />
              </DockPanel>
            </Border>
          </Popup>
          <TextBlock Margin="0,14,0,0" TextWrapping="Wrap" Text="{Binding Status}"/>
          <TextBlock Margin="0,14,0,0" TextWrapping="Wrap"
                     Text="TUR005: Şifreli kasa ve kullanıcı onaylı eski not aktarımı Alpha aşamasındadır. Madde kimlikleri/üstveriler şifresizdir; eski notlar ayrıca düz metin olarak kalır. Fiziksel Windows kabulü yapılmadı."/>
        </StackPanel>
      </DataTemplate>
      <DataTemplate DataType="{x:Type vm:SystematicsPage}">
        <StackPanel>
          <TextBlock Text="{Binding Title}" FontSize="23" FontWeight="Bold"/>
          <TextBlock TextWrapping="Wrap" Margin="0,6,0,12" Text="{Binding Description}"/>
          <Button Content="{Binding ButtonTitle}" Command="{Binding OpenCommand}"
                  HorizontalAlignment="Left" FontWeight="Bold"
                  AutomationProperties.Name="Sistematik şema ve dosya denetimi panelini aç ya da kapat"/>
          <TextBlock Margin="0,8,0,0" FontSize="11" TextWrapping="Wrap"
                     Text="Eğitim ve insan denetimi içindir. Mevzuatın olay tarihli resmî metni, iptal/yürütme durdurma kararları ve somut delil kontrolü ayrıca gerekir."/>
          <Border Visibility="{Binding Opened, Converter={StaticResource BooleanVisibility}}"
                  Padding="12" Margin="0,14,0,0" BorderThickness="1"
                  BorderBrush="{DynamicResource BorderBrush}" CornerRadius="8">
            <StackPanel>
              <WrapPanel>
                <Button Content="Öğretici Şema" Command="{Binding DiagramCommand}"/>
                <Button Content="Dosya Üzerinde Denetim" Command="{Binding AuditCommand}"/>
              </WrapPanel>
              <ScrollViewer VerticalScrollBarVisibility="Auto" MaxHeight="430">
                <StackPanel>
                  <StackPanel Visibility="{Binding IsSearch, Converter={StaticResource BooleanVisibility}}">
                    <Border Background="{DynamicResource BackgroundBrush}"
                            BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                            CornerRadius="7" Padding="10" Margin="0,8,0,12">
                      <StackPanel>
                        <TextBlock FontSize="16" FontWeight="Bold"
                                   Text="Hukuki Kaynak, İptal ve Yürütmeyi Durdurma Riskleri"/>
                        <TextBlock Margin="0,4,0,5" TextWrapping="Wrap" FontSize="11"
                                   Text="Asıl Danıştay kararlarının tam metni ve sonraki safahat henüz doğrulanmadı. Tarihsel Bakanlık PDF'si güncel resmî metin kabul edilemez."/>
                        <ItemsControl ItemsSource="{Binding NormRisks}">
                          <ItemsControl.ItemTemplate>
                            <DataTemplate>
                              <StackPanel Margin="0,6,0,8">
                                <TextBlock Text="{Binding Title}" FontWeight="Bold"/>
                                <TextBlock Text="{Binding Warning}" TextWrapping="Wrap"/>
                                <TextBlock Text="{Binding Reference}" FontSize="11" TextWrapping="Wrap"/>
                                <TextBlock Text="{Binding EvidenceGrade}" FontSize="11" TextWrapping="Wrap"/>
                                <TextBlock Text="{Binding DiscoveryUrl}" FontSize="11" TextWrapping="Wrap"/>
                              </StackPanel>
                            </DataTemplate>
                          </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <TextBlock Margin="0,11,0,4" FontWeight="Bold" FontSize="15"
                                   Text="Danıştay Kararları — Kanıt Düzeyi Defteri"/>
                        <TextBlock TextWrapping="Wrap" FontSize="11" Margin="0,0,0,6"
                                   Text="2007 kararının dergide yayımlanan METNİ bulundu; bu Danıştay imzalı/resmî asıl suret değildir. 2012 onaması ve 2025 YD için yalnız ikincil kayıt var. m.8(c) ile m.27 iptal edilmiş gibi gösterilmez."/>
                        <TextBlock TextWrapping="Wrap" FontSize="11" FontWeight="Bold" Margin="0,4,0,4"
                                   Text="{Binding OfficialCourtOriginalStatus}"/>
                        <TextBlock TextWrapping="Wrap" FontSize="11" Text="{Binding OfficialCourtSearchPortal}"/>
                        <TextBlock TextWrapping="Wrap" FontSize="11" Text="{Binding OfficialCourtDocketPortal}"/>
                        <ItemsControl ItemsSource="{Binding CourtDecisions}">
                          <ItemsControl.ItemTemplate>
                            <DataTemplate>
                              <Border Margin="0,3,0,7" Padding="8"
                                      Background="{DynamicResource BackgroundBrush}"
                                      BorderThickness="1" BorderBrush="{DynamicResource BorderBrush}" CornerRadius="6">
                                <StackPanel>
                                  <TextBlock Text="{Binding DecisionIdentity}" FontWeight="Bold" TextWrapping="Wrap"/>
                                  <TextBlock Text="{Binding RecordedDisposition}" TextWrapping="Wrap"/>
                                  <TextBlock Text="{Binding Publication}" FontSize="11" TextWrapping="Wrap"/>
                                  <TextBlock Text="{Binding Level}" FontSize="11"/>
                                  <TextBlock Text="{Binding OutstandingVerification}" FontSize="11" TextWrapping="Wrap"/>
                                  <TextBlock Text="{Binding SourceUrl}" FontSize="11" TextWrapping="Wrap"/>
                                </StackPanel>
                              </Border>
                            </DataTemplate>
                          </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <TextBlock Margin="0,6,0,2" Text="Olay tarihi — yyyy-MM-dd (manuel norm incelemesi)"/>
                        <TextBox Width="235" MaxLength="10" HorizontalAlignment="Left"
                                 Text="{Binding EventDate, UpdateSourceTrigger=PropertyChanged}"/>
                        <Button Margin="0,5,0,5" Content="Tarihsel Norm Risklerini Göster"
                                HorizontalAlignment="Left" Command="{Binding ReviewNormCommand}"/>
                        <TextBlock Text="{Binding NormSummary}" TextWrapping="Wrap"/>
                        <Border BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                                Padding="10" CornerRadius="6" Margin="0,12,0,8">
                          <StackPanel>
                            <TextBlock FontWeight="Bold" FontSize="15" TextWrapping="Wrap"
                                       Text="CMK 134 — AYM İptali / 25.02.2027 Tarihsel Kaynak Uyarısı"/>
                            <TextBlock TextWrapping="Wrap" FontSize="11" Margin="0,5,0,4"
                                       Text="{Binding Aym134Warning}"/>
                            <TextBlock TextWrapping="Wrap" FontSize="11" Text="{Binding Aym134GazetteUrl}"/>
                            <TextBlock TextWrapping="Wrap" FontSize="11" Text="{Binding Aym134ReproductionUrl}"/>
                            <TextBlock TextWrapping="Wrap" FontSize="11"
                                       Text="RESMÎ KARAR LİSTESİ YAYIM KAYDI, imzalı tam karar aslına veya olay tarihli CMK 134'ün kesin geçerliliğine eşdeğer değildir. Doğrulanmış kanun korpusu olmadan otomatik hukuki uygunluk yok."/>
                          </StackPanel>
                        </Border>

                        <TextBlock FontWeight="Bold" FontSize="15" Margin="0,12,0,5"
                                   Text="CMK 127/3 — Elkoyma 24/48 Saat Evrak Karşılaştırması"/>
                        <TextBlock Margin="0,8,0,3" FontWeight="Bold" TextWrapping="Wrap"
                                   Text="ÖN ŞART — Elkoyma önceden hâkim kararına mı dayanıyor?"/>
                        <ComboBox Width="490" HorizontalAlignment="Left" MaxWidth="490"
                                  ItemsSource="{Binding BasisOptions}"
                                  DisplayMemberPath="Title" SelectedValuePath="Value"
                                  SelectedValue="{Binding AuthorizationBasis, Mode=TwoWay}"
                                  AutomationProperties.Name="CMK 127 önceki hâkim kararı dayanak seçimi"/>
                        <TextBlock Margin="0,4,0,8" TextWrapping="Wrap" FontSize="11"
                                   Text="Seçim yalnız kullanıcı beyanıdır. Dayanak belirsizse 24/48 saat hesabı bloke olur. Önceden hâkim kararı bildirildiğinde, kararsız elkoymaya özgü karşılaştırma uygulanmaz; özgün kararın kapsamı ayrıca incelenir."/>

                        <TextBlock TextWrapping="Wrap" FontSize="11"
                                   Text="Biçim: 2026-11-20T14:30+03:00. 24 saat hâkime sunma; 48 saat elkoymadan itibaren karar açıklama referansıdır. Sonuç yalnız aritmetiktir; gerçek belge veya hukuki uygunluk onayı değildir."/>
                        <TextBlock Margin="0,7,0,2" Text="Elkoyma anı"/>
                        <TextBox Width="320" MaxLength="26" HorizontalAlignment="Left"
                                 Text="{Binding SeizureTime, UpdateSourceTrigger=PropertyChanged}"/>
                        <TextBlock Margin="0,7,0,2" Text="Hâkime sunma anı"/>
                        <TextBox Width="320" MaxLength="26" HorizontalAlignment="Left"
                                 Text="{Binding SubmissionTime, UpdateSourceTrigger=PropertyChanged}"/>
                        <TextBlock Margin="0,7,0,2" Text="Hâkim kararının açıklanma anı"/>
                        <TextBox Width="320" MaxLength="26" HorizontalAlignment="Left"
                                 Text="{Binding DecisionTime, UpdateSourceTrigger=PropertyChanged}"/>
                        <TextBlock Margin="0,10,0,2" Text="Elkoyma evrakı — yalnız KİMLİKSİZ referans"/>
                        <TextBox Width="320" MaxLength="96" HorizontalAlignment="Left"
                                 Text="{Binding SeizureEvidence, UpdateSourceTrigger=PropertyChanged}"/>
                        <TextBlock Margin="0,5,0,2" Text="Hâkime sunma evrakı — yalnız KİMLİKSİZ referans"/>
                        <TextBox Width="320" MaxLength="96" HorizontalAlignment="Left"
                                 Text="{Binding SubmissionEvidence, UpdateSourceTrigger=PropertyChanged}"/>
                        <TextBlock Margin="0,5,0,2" Text="Hâkim kararı evrakı — yalnız KİMLİKSİZ referans"/>
                        <TextBox Width="320" MaxLength="96" HorizontalAlignment="Left"
                                 Text="{Binding DecisionEvidence, UpdateSourceTrigger=PropertyChanged}"/>
                        <TextBlock Margin="0,7,0,4" TextWrapping="Wrap" FontSize="11"
                                   Text="Evrakın resmî kaydı/imzası programca doğrulanmaz. Kaynaklar ve içerik hiçbir yere otomatik aktarılmaz."/>
                        <Button Margin="0,7,0,5" Content="Saatleri Aritmetik Karşılaştır"
                                HorizontalAlignment="Left" Command="{Binding CompareClockCommand}"/>
                        <TextBlock Text="{Binding ClockSummary}" TextWrapping="Wrap"/>
                        <TextBlock Text="{Binding EvidenceSummary}" TextWrapping="Wrap" Margin="0,5,0,0"/>
                      </StackPanel>
                    </Border>
                  </StackPanel>
                  <StackPanel Visibility="{Binding ShowDiagram, Converter={StaticResource BooleanVisibility}}">
                    <TextBlock FontWeight="Bold" FontSize="17" Margin="0,10,0,8"
                               Text="Şematik süreç — aşama → şart → dayanak → dosya belgesi"/>
                    <ItemsControl ItemsSource="{Binding Steps}">
                      <ItemsControl.ItemTemplate>
                        <DataTemplate>
                          <StackPanel>
                            <Border BorderThickness="1" CornerRadius="7" Padding="10"
                                    BorderBrush="{DynamicResource BorderBrush}"
                                    Background="{DynamicResource BackgroundBrush}" Margin="0,4,0,1">
                              <StackPanel>
                                <TextBlock FontWeight="Bold" Text="{Binding Phase}"/>
                                <TextBlock TextWrapping="Wrap" Margin="0,4,0,0" Text="{Binding Question}"/>
                                <TextBlock TextWrapping="Wrap" FontSize="11" Margin="0,5,0,0"
                                           Text="{Binding PracticalEvidence}"/>
                                <TextBlock TextWrapping="Wrap" FontSize="11" FontWeight="Bold"
                                           Text="{Binding LegalReferences}"/>
                              </StackPanel>
                            </Border>
                            <TextBlock Text="↓" FontSize="18" HorizontalAlignment="Center"/>
                          </StackPanel>
                        </DataTemplate>
                      </ItemsControl.ItemTemplate>
                    </ItemsControl>
                  </StackPanel>
                  <StackPanel Visibility="{Binding ShowAudit, Converter={StaticResource BooleanVisibility}}">
                    <TextBlock Margin="0,10,0,6" FontSize="17" FontWeight="Bold"
                               Text="Dosya üzerinde denetim — evrak bazlı kontrol"/>
                    <TextBlock TextWrapping="Wrap" FontSize="11"
                               Text="Yalnız kimliksiz evrak referansları girin; kişisel bilgi veya soruşturma içeriği yazmayın. İşaretler yalnız RAM'de kalır. Belgeyle kontrol edildi ve Uygulanmaz durumlarına kanıt/gerekçe gereklidir."/>
                    <TextBlock Text="Kimliksiz dosya kodu (isteğe bağlı)" Margin="0,9,0,1"/>
                    <TextBox Text="{Binding FileCode, UpdateSourceTrigger=PropertyChanged}" MaxLength="48"
                             Width="280" HorizontalAlignment="Left" />
                    <TextBlock Text="{Binding ReviewSummary}" TextWrapping="Wrap"
                               FontWeight="Bold" Margin="0,7,0,10"/>
                    <ItemsControl ItemsSource="{Binding Rows}">
                      <ItemsControl.ItemTemplate>
                        <DataTemplate>
                          <Border Padding="10" Margin="0,4,0,5" CornerRadius="6"
                                  BorderThickness="1" BorderBrush="{DynamicResource BorderBrush}"
                                  Background="{DynamicResource BackgroundBrush}">
                            <StackPanel>
                              <TextBlock FontWeight="Bold" Text="{Binding Check.Phase}"/>
                              <TextBlock Text="{Binding Check.Question}" TextWrapping="Wrap" Margin="0,3,0,4"/>
                              <TextBlock Text="{Binding Check.LegalReferences}" TextWrapping="Wrap"
                                         FontSize="11" Margin="0,0,0,5"/>
                              <ComboBox Width="255" HorizontalAlignment="Left"
                                        ItemsSource="{Binding Options}"
                                        DisplayMemberPath="DisplayName" SelectedValuePath="Code"
                                        SelectedValue="{Binding State, Mode=TwoWay}"/>
                              <TextBox Text="{Binding Evrak, UpdateSourceTrigger=PropertyChanged}" MaxLength="180"
                                       ToolTip="Kimliksiz evrak referansı veya uygulanmaz gerekçesi"
                                       AutomationProperties.Name="Evrak referansı ve gerekçe"/>
                            </StackPanel>
                          </Border>
                        </DataTemplate>
                      </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <TextBlock Text="{Binding ReviewSummary}" FontWeight="Bold" TextWrapping="Wrap"
                               Margin="0,9,0,8"/>
                    <WrapPanel>
                      <Button Content="Denetim Metnini Kopyala" Command="{Binding CopyCommand}"/>
                      <Button Content="Kontrolü Temizle" Command="{Binding ResetCommand}"/>
                    </WrapPanel>
                    <TextBlock Text="{Binding Message}" TextWrapping="Wrap" Margin="0,8,0,0"/>
                  </StackPanel>
                </StackPanel>
              </ScrollViewer>
            </StackPanel>
          </Border>
        </StackPanel>
      </DataTemplate>
      <DataTemplate DataType="{x:Type vm:PlaceholderViewModel}">
        <StackPanel>
          <TextBlock FontSize="21" FontWeight="Bold" Text="{Binding Title}"/>
          <TextBlock Margin="0,16,0,0" TextWrapping="Wrap" Text="{Binding Message}"/>
        </StackPanel>
      </DataTemplate>
    </ResourceDictionary>
  </Application.Resources>
</Application>
