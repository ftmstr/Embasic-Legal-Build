                          <Trigger Property="IsSelected" Value="True">
                            <Setter Property="Background" Value="{DynamicResource SurfaceBrush}"/>
                            <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
                          </Trigger>
                        </Style.Triggers>
                      </Style>
                      <Style x:Key="CmkMatrixCell" TargetType="TextBlock">
                        <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
                        <Setter Property="TextWrapping" Value="Wrap"/>
                        <Setter Property="Margin" Value="4,6"/>
                      </Style>
                    </DataGrid.Resources>
                    <DataGrid.Columns>
                      <DataGridTextColumn ElementStyle="{StaticResource CmkMatrixCell}" Header="Ölçüt" Width="120" Binding="{Binding Criterion}"/>
                      <DataGridTextColumn ElementStyle="{StaticResource CmkMatrixCell}" Header="Birinci kavram" Width="275"
                                          Binding="{Binding Left}"/>
                      <DataGridTextColumn ElementStyle="{StaticResource CmkMatrixCell}" Header="İkinci kavram" Width="265"
                                          Binding="{Binding Right}"/>
                      <DataGridTextColumn ElementStyle="{StaticResource CmkMatrixCell}" Header="Neden önemli?" Width="245"
                                          Binding="{Binding Reason}"/>
                    </DataGrid.Columns>
                  </DataGrid>
                  <DataGrid ItemsSource="{Binding Matrix}" Visibility="{Binding NoStudy, Converter={StaticResource BooleanVisibility}}" AutoGenerateColumns="False"
                            Background="{DynamicResource BackgroundBrush}" Foreground="{DynamicResource TextBrush}"
                            RowBackground="{DynamicResource BackgroundBrush}" AlternatingRowBackground="{DynamicResource SurfaceBrush}"
                            IsReadOnly="True" CanUserAddRows="False" CanUserDeleteRows="False"
                            RowHeaderWidth="0" HeadersVisibility="Column"
                            GridLinesVisibility="Horizontal" Height="350"
                            HorizontalScrollBarVisibility="Auto"
                            VerticalScrollBarVisibility="Auto"
                            AutomationProperties.Name="CMK uygulama kontrol tablosu">
                    <DataGrid.Resources>
                      <Style TargetType="DataGridColumnHeader">
                        <Setter Property="Background" Value="{DynamicResource SurfaceBrush}"/>
                        <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
