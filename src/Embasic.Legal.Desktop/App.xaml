                    <TextBlock Text="Dersler kavramsal eğitim taslağıdır; güncel madde lafzı ve yürürlük doğrulanmadı. Şemada bir yol seçerek gerekçesini inceleyin; uygulama testinde yanlış cevaptan sonra yeniden deneyebilirsiniz."
                               TextWrapping="Wrap" FontSize="12" Margin="0,20,0,0"/>
                  </StackPanel>
                </ScrollViewer>
              </TabItem>
              <TabItem Header="1 · Şema">
                <ScrollViewer VerticalScrollBarVisibility="Auto" MaxHeight="440">
                  <StackPanel Margin="10">
                    <TextBlock FontSize="16" FontWeight="Bold" Text="İşlem akışını öğren: bir adımı seç"/>
                    <TextBlock Text="Başlıklara tıklayın; seçili aşamanın açıklamasını okuyun. Şema bir hukukî işlem izni üretmez."
                               TextWrapping="Wrap" FontSize="12" Margin="0,5,0,10"/>
                    <ItemsControl ItemsSource="{Binding FlowChoices}">
                      <ItemsControl.ItemTemplate>
                        <DataTemplate>
                          <Border Padding="3" Margin="0,3" CornerRadius="7" BorderThickness="2">
                            <Border.Style>
                              <Style TargetType="Border">
                                <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
                                <Style.Triggers>
                                  <DataTrigger Binding="{Binding Active}" Value="True">
                                    <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
                                  </DataTrigger>
                                </Style.Triggers>
                              </Style>
