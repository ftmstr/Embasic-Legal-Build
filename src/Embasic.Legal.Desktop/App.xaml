              <TabItem Header="3 · Kontrol listesi">
                <ScrollViewer VerticalScrollBarVisibility="Auto" MaxHeight="435">
                  <StackPanel Margin="10">
                    <TextBlock FontSize="16" FontWeight="Bold" Text="Dosya hazırlığı — yalnız kişisel eğitim işaretleri"/>
                    <TextBlock TextWrapping="Wrap" FontSize="11" Margin="0,5,0,8"
                               Text="İşaretler RAM'de kalır; belgeyi gerçek, imzalı veya yeterli saymaz. Dosya numarası, isim veya suç içeriği girilmez."/>
                    <ItemsControl ItemsSource="{Binding Checklist}">
                      <ItemsControl.ItemTemplate>
