                            </Border>
                          </DataTemplate>
                        </ItemsControl.ItemTemplate>
                      </ItemsControl>
                      <TextBlock Text="↓ Seçiminizi gerekçeyle karşılaştırın" FontWeight="Bold" Margin="0,10"/>
                      <Border BorderBrush="{DynamicResource AccentBrush}" BorderThickness="1" Padding="14" CornerRadius="8">
                        <TextBlock Text="{Binding BranchFeedback}" TextWrapping="Wrap"/>
                      </Border>
                    </StackPanel>
                  </StackPanel>
                </ScrollViewer>
