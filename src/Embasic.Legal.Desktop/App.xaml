                      <Border Background="{DynamicResource BackgroundBrush}" CornerRadius="8" Padding="14">
                        <TextBlock Text="{Binding Study.BranchCase.Prompt}" TextWrapping="Wrap" FontSize="14"/>
                      </Border>
                      <TextBlock Text="↓ Hangi çıkarımı savunursunuz?" FontWeight="Bold" Margin="0,10"/>
                      <ItemsControl ItemsSource="{Binding BranchChoices}">
