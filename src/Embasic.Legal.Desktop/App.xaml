                    <Border Background="{DynamicResource BackgroundBrush}" Padding="14" CornerRadius="8">
                      <StackPanel>
                        <TextBlock Text="Birbirine karıştırma" FontSize="16" FontWeight="Bold"/>
                        <TextBlock Text="{Binding Lesson.Distinction}" TextWrapping="Wrap" Margin="0,7,0,0" FontSize="14"/>
                      </StackPanel>
                    </Border>
                    <TextBlock Text="Örnek üzerinde düşün" FontSize="16" FontWeight="Bold" Margin="0,18,0,5"/>
                    <TextBlock Text="{Binding Lesson.Example}" TextWrapping="Wrap" FontSize="14"/>
                    <StackPanel Visibility="{Binding HasStudy, Converter={StaticResource BooleanVisibility}}" Margin="0,20,0,0">
                      <TextBlock Text="Öğrenme rotası: Anla → Karşılaştır → Hatırla → Uygula" FontWeight="Bold" TextWrapping="Wrap"/>
                      <ItemsControl ItemsSource="{Binding Study.Objectives}" Margin="0,9,0,12">
                        <ItemsControl.ItemTemplate>
                          <DataTemplate><TextBlock Text="{Binding}" TextWrapping="Wrap" Margin="5,4"/></DataTemplate>
                        </ItemsControl.ItemTemplate>
                      </ItemsControl>
                      <Border Background="{DynamicResource BackgroundBrush}" Padding="12" CornerRadius="7">
                        <TextBlock Text="{Binding Study.ArticleReadingGuide}" TextWrapping="Wrap" FontSize="12"/>
