                      <DataGridTextColumn ElementStyle="{StaticResource CmkMatrixCell}" Header="Ön inceleme sorusu" Width="275"
                                          Binding="{Binding HumanReviewQuestion}"/>
                      <DataGridTextColumn ElementStyle="{StaticResource CmkMatrixCell}" Header="Aranacak belge" Width="265"
                                          Binding="{Binding DocumentToInspect}"/>
                      <DataGridTextColumn ElementStyle="{StaticResource CmkMatrixCell}" Header="Açık risk" Width="245"
                                          Binding="{Binding UnresolvedRisk}"/>
