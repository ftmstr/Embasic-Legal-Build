                            <TextBlock Text="{Binding Right}" TextWrapping="Wrap" Margin="0,3,0,11"/>
                            <Border Background="{DynamicResource SurfaceBrush}" CornerRadius="5" Padding="10">
                              <StackPanel>
                                <TextBlock Text="Neden önemli?" FontWeight="Bold" FontSize="12"/>
                                <TextBlock Text="{Binding Reason}" TextWrapping="Wrap" Margin="0,4,0,0"/>
                              </StackPanel>
                            </Border>
                          </StackPanel>
                        </Border>
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                  <ItemsControl ItemsSource="{Binding Matrix}"
                                Visibility="{Binding NoStudy, Converter={StaticResource BooleanVisibility}}"
                                AutomationProperties.Name="CMK işlem kontrol okuma kartları">
                    <ItemsControl.ItemTemplate>
                      <DataTemplate>
                        <Border BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                                Background="{DynamicResource BackgroundBrush}" CornerRadius="8"
                                Padding="13" Margin="0,4,0,7">
