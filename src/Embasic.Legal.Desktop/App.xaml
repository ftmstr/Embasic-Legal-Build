                        <TextBlock Text="{Binding ActiveFlow.ReviewPrompt}" TextWrapping="Wrap"/>
                        <TextBlock Text="{Binding ActiveFlow.DocumentToInspect}" TextWrapping="Wrap" FontSize="11" Margin="0,8,0,0"/>
                        <Button Content="Sonraki adımı incele" Command="{Binding NextFlowCommand}" HorizontalAlignment="Left" Margin="0,10,0,0"/>
                      </StackPanel>
                    </Border>
                    <StackPanel Visibility="{Binding HasStudy, Converter={StaticResource BooleanVisibility}}">
                      <TextBlock Text="↓" FontSize="24" HorizontalAlignment="Center"/>
