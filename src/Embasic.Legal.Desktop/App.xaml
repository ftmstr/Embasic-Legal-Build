<Application x:Class="Embasic.Legal.Desktop.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:Embasic.Legal.Desktop.ViewModels"
             StartupUri="MainWindow.xaml">
  <Application.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="Themes/Dark.xaml" />
      </ResourceDictionary.MergedDictionaries>
      <BitmapImage x:Key="EmbasicLogo" UriSource="pack://application:,,,/assets/Embasic_Legal_E_Terazi_Ikon.png" />
      <BooleanToVisibilityConverter x:Key="BooleanVisibility" />
      <Style TargetType="TextBlock">
        <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
      </Style>
      <Style TargetType="TextBox">
        <Setter Property="Padding" Value="8" />
        <Setter Property="Margin" Value="0,4,0,10" />
        <Setter Property="Background" Value="{DynamicResource SurfaceBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
      </Style>
      <Style TargetType="Button">
        <Setter Property="Padding" Value="12,8" />
        <Setter Property="Margin" Value="0,3,7,3" />
        <Setter Property="Background" Value="{DynamicResource SurfaceBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
      </Style>
      <Style TargetType="CheckBox">
        <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
        <Setter Property="Margin" Value="0,5,0,9" />
      </Style>
      <DataTemplate DataType="{x:Type vm:DashboardViewModel}">
        <StackPanel>
          <TextBlock FontSize="27" FontWeight="Bold" Text="Embasic Legal 2.0 — Windows Alpha"/>
          <TextBlock FontSize="15" TextWrapping="Wrap" Margin="0,20,0,0"
                     Text="Gerçek WPF masaüstü uygulaması. İlk geliştirme turunda takvim hesaplama çekirdeği etkinleştirildi."/>
          <TextBlock Margin="0,14,0,0" TextWrapping="Wrap" Text="Mevzuat ve resmî UYAP güneş çizelgesi doğrulanmadı; hukuki üretim NO-GO."/>
        </StackPanel>
      </DataTemplate>
      <DataTemplate DataType="{x:Type vm:CalculatorHubViewModel}">
        <StackPanel>
          <TextBlock FontSize="22" FontWeight="Bold" Text="Adli Hesaplama Merkezi"/>
          <TextBlock Margin="0,13,0,0" TextWrapping="Wrap" Text="Tarih karşılaştırması, tarihe gün/ay/yıl ekleme ve Gece Vakti için sol menüdeki araçları seçin."/>
          <TextBlock Margin="0,15,0,0" TextWrapping="Wrap" Text="Diğer eski hesaplamalar sonraki turlarda C# motoruna aktarılacaktır."/>
        </StackPanel>
      </DataTemplate>
      <DataTemplate DataType="{x:Type vm:DateRangeViewModel}">
        <ScrollViewer VerticalScrollBarVisibility="Auto">
          <StackPanel MaxWidth="640" HorizontalAlignment="Left">
            <TextBlock FontSize="21" FontWeight="Bold" Text="Belirli Tarih / Olay Tarihi"/>
            <TextBlock Margin="0,10,0,2" Text="Olay tarihi (gg.aa.yyyy)"/>
            <TextBox Width="220" HorizontalAlignment="Left" Text="{Binding EventDate, UpdateSourceTrigger=PropertyChanged}"/>
            <TextBlock Text="Belirli tarih (gg.aa.yyyy)"/>
            <TextBox Width="220" HorizontalAlignment="Left" Text="{Binding ReferenceDate, UpdateSourceTrigger=PropertyChanged}"/>
            <TextBlock Margin="0,6,0,2" Text="İsteğe bağlı tarih kaydırma — önce yıl, sonra ay, sonra gün"/>
            <StackPanel Orientation="Horizontal">
              <StackPanel Margin="0,0,14,0"><TextBlock Text="Yıl"/><TextBox Width="85" Text="{Binding Years, UpdateSourceTrigger=PropertyChanged}"/></StackPanel>
              <StackPanel Margin="0,0,14,0"><TextBlock Text="Ay"/><TextBox Width="85" Text="{Binding Months, UpdateSourceTrigger=PropertyChanged}"/></StackPanel>
              <StackPanel><TextBlock Text="Gün"/><TextBox Width="85" Text="{Binding Days, UpdateSourceTrigger=PropertyChanged}"/></StackPanel>
            </StackPanel>
            <CheckBox Content="Belirli tarihe uygula (işaretli değilse olay tarihine)" IsChecked="{Binding ApplyToReference}"/>
            <CheckBox Content="Ekle yerine çıkar" IsChecked="{Binding Subtract}"/>
            <StackPanel Orientation="Horizontal"><Button Width="135" Content="Hesapla" Command="{Binding CalculateCommand}"/><Button Width="135" Content="Sonucu kopyala" Command="{Binding CopyCommand}"/></StackPanel>
            <TextBlock Margin="0,20,0,0" TextWrapping="Wrap" FontSize="15" Text="{Binding Result}"/>
            <TextBlock Margin="0,15,0,0" TextWrapping="Wrap" Text="Takvimsel hesap. Kanuni süre veya lehe kanun değerlendirmesi değildir."/>
          </StackPanel>
        </ScrollViewer>
      </DataTemplate>
      <DataTemplate DataType="{x:Type vm:DateShiftViewModel}">
        <ScrollViewer VerticalScrollBarVisibility="Auto">
          <StackPanel MaxWidth="640" HorizontalAlignment="Left">
            <TextBlock FontSize="21" FontWeight="Bold" Text="Tarihe Gün / Ay / Yıl Ekle–Çıkar"/>
            <TextBlock Margin="0,12,0,2" Text="Başlangıç tarihi (gg.aa.yyyy)"/>
            <TextBox Width="210" HorizontalAlignment="Left" Text="{Binding Date, UpdateSourceTrigger=PropertyChanged}"/>
            <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
              <StackPanel Margin="0,0,14,0"><TextBlock Text="Yıl"/><TextBox Width="85" Text="{Binding Years, UpdateSourceTrigger=PropertyChanged}"/></StackPanel>
              <StackPanel Margin="0,0,14,0"><TextBlock Text="Ay"/><TextBox Width="85" Text="{Binding Months, UpdateSourceTrigger=PropertyChanged}"/></StackPanel>
              <StackPanel><TextBlock Text="Gün"/><TextBox Width="85" Text="{Binding Days, UpdateSourceTrigger=PropertyChanged}"/></StackPanel>
            </StackPanel>
            <CheckBox Content="Ekle yerine çıkar" IsChecked="{Binding Subtract}"/>
            <Button Width="135" HorizontalAlignment="Left" Content="Hesapla" Command="{Binding CalculateCommand}"/>
            <TextBlock Margin="0,18,0,0" FontSize="15" TextWrapping="Wrap" Text="{Binding Result}"/>
            <TextBlock Margin="0,15,0,0" TextWrapping="Wrap" Text="Sıra: yıl → ay → gün. Ay sonu .NET takvim kurallarıyla kırpılır; bu hukuki süre hesabı değildir."/>
          </StackPanel>
        </ScrollViewer>
      </DataTemplate>
      <DataTemplate DataType="{x:Type vm:NightViewModel}">
        <StackPanel>
          <TextBlock FontSize="21" FontWeight="Bold" Text="Gece Vakti"/>
          <TextBlock Margin="0,15,0,2" Text="İl"/>
          <ComboBox Width="225" HorizontalAlignment="Left" Margin="0,4,0,10" ItemsSource="{Binding Provinces}" SelectedItem="{Binding Province}"/>
          <TextBlock Text="Olay tarihi (gg.aa.yyyy)"/>
          <TextBox Width="225" HorizontalAlignment="Left" Text="{Binding Date, UpdateSourceTrigger=PropertyChanged}"/>
          <TextBlock Text="Olay saati (isteğe bağlı)"/>
          <TextBox Width="225" HorizontalAlignment="Left" Text="{Binding EventTime, UpdateSourceTrigger=PropertyChanged}"/>
          <Button Content="Resmî kaynağı denetle" Width="190" HorizontalAlignment="Left" Command="{Binding CheckCommand}"/>
          <TextBlock Margin="0,18,0,0" TextWrapping="Wrap" FontSize="15" Text="{Binding Result}"/>
          <TextBlock Margin="0,15,0,0" TextWrapping="Wrap" Text="Bu Alpha sürüm, resmî UYAP çizelgesi olmadan güneş saati veya TCK gece vakti üretmez."/>
        </StackPanel>
      </DataTemplate>
      <DataTemplate DataType="{x:Type vm:LegislationViewModel}">
        <StackPanel>
          <TextBlock FontSize="21" FontWeight="Bold" Text="Mevzuat — Kaynak Dizini"/>
          <TextBlock Margin="0,10,0,14" TextWrapping="Wrap" Text="15 düzenleme yalnızca ad ve numara olarak kaydedilmiştir. Resmî tam metin doğrulanmadı. Madde araması/not baloncuğu sonraki turda geliştirilecektir."/>
          <ListBox Height="260" Width="720" HorizontalAlignment="Left" ItemsSource="{Binding Laws}"
                   SelectedItem="{Binding SelectedLaw, Mode=TwoWay}" DisplayMemberPath="DisplayName"/>
          <TextBlock Margin="0,10,0,4" TextWrapping="Wrap"
                     Text="Resmî madde metni doğrulanmadı: hiçbir maddeye gerçek mevzuat etiketiyle not bağlanmaz." />
          <Button Width="265" HorizontalAlignment="Left" Content="Yerel PDF adayı ekle (5237/5271)"
                  Command="{Binding ImportPdfCommand}"/>
          <TextBlock Margin="0,8,0,0" TextWrapping="Wrap" Text="{Binding ReceiptStatus}" />

        </StackPanel>
      </DataTemplate>
      <DataTemplate DataType="{x:Type vm:NoteSandboxViewModel}">
        <StackPanel MaxWidth="750" HorizontalAlignment="Left">
          <TextBlock FontSize="22" FontWeight="Bold" Text="Madde Notu — WPF Deneme Alanı"/>
          <TextBlock Margin="0,10,0,14" TextWrapping="Wrap"
                     Text="SENTETİK ÖRNEK: Bu satır gerçek bir kanun maddesi değildir. Resmî mevzuat metinleri onaylanmadığı için yalnızca not baloncuğu/sticker kullanıcı deneyimi denenebilir. Gerçek soruşturma bilgisi girmeyin." />
          <TextBlock Margin="0,2,0,7" FontWeight="Bold" Text="Şifreli kasa — en az 12 karakter parola"/>
          <PasswordBox x:Name="VaultPassword" Width="330" Height="32" HorizontalAlignment="Left"
                       AutomationProperties.Name="Şifreli kasa parolası (ekranda gizlenir)"/>
          <WrapPanel Margin="0,7,0,10">
            <Button Content="Kasayı aç / oluştur" Command="{Binding UnlockCommand}"
                    CommandParameter="{Binding ElementName=VaultPassword}"/>
            <Button Content="Yedeği geri yükle (kilitliyken)" Command="{Binding RestoreCommand}"
                    CommandParameter="{Binding ElementName=VaultPassword}"/>
            <Button Content="Kasayı kilitle" Command="{Binding LockCommand}"/>
            <Button Content="Şifreli yedeği dışa aktar" Command="{Binding ExportBackupCommand}"/>
          </WrapPanel>
          <TextBlock Margin="0,0,0,10" TextWrapping="Wrap" FontSize="11"
                     Text="Parolanızı kaybederseniz kasa kurtarılamaz. Eski TUR003 düz metin notları ayrı tutulur; otomatik taşınmaz. Gizli soruşturma verisi GİRMEYİN."/>
          <Border BorderThickness="1" BorderBrush="{DynamicResource BorderBrush}"
                  CornerRadius="8" Padding="12" Background="{DynamicResource BackgroundBrush}">
            <StackPanel Orientation="Horizontal">
              <Button x:Name="ExampleArticleButton" Content="ÖRNEK MADDE — not baloncuğunu aç"
                      Command="{Binding ToggleCommand}" ToolTip="Sentetik not örneğini aç/kapat"/>
              <TextBlock Text="📝" Margin="6,3,0,0" FontSize="19"
                         ToolTip="Bu örnek maddede kayıtlı not var"
                         AutomationProperties.Name="Bu örnek maddede not var"
                         Visibility="{Binding HasNote, Converter={StaticResource BooleanVisibility}}"/>
            </StackPanel>
          </Border>
          <Popup IsOpen="{Binding IsOpen, Mode=TwoWay}"
                 PlacementTarget="{Binding ElementName=ExampleArticleButton}"
                 Placement="Bottom" StaysOpen="True" AllowsTransparency="True"
                 PopupAnimation="Fade">
            <Border Width="{Binding EditorWidth}" Height="{Binding EditorHeight}" Padding="12"
                    CornerRadius="10" BorderThickness="2"
                    BorderBrush="{DynamicResource AccentBrush}"
                    Background="{DynamicResource SurfaceBrush}">
              <DockPanel LastChildFill="True">
                <StackPanel DockPanel.Dock="Top">
                  <TextBlock FontWeight="Bold" FontSize="16" Text="📝 Sentetik madde notu"/>
                  <TextBlock Margin="0,5,0,7" FontSize="11" TextWrapping="Wrap"
                             Text="Yalnız arayüz testi — gerçek kanun maddesi veya gizli dosya değil."/>
                </StackPanel>
                <StackPanel DockPanel.Dock="Bottom" Margin="0,8,0,0">
                  <WrapPanel>
                    <Button Content="Kaydet" Command="{Binding SaveCommand}"/>
                    <Button Content="Genişlet / Küçült" Command="{Binding ExpandCommand}"/>
                    <Button Content="Sil" Command="{Binding DeleteCommand}"/>
                    <Button Content="Kapat" Command="{Binding CloseCommand}"/>
                  </WrapPanel>
                  <TextBlock Margin="0,3,0,0" FontSize="11" TextWrapping="Wrap" Text="{Binding Status}"/>
                </StackPanel>
                <TextBox Text="{Binding Draft, UpdateSourceTrigger=PropertyChanged}"
                         AcceptsReturn="True" TextWrapping="Wrap"
                         VerticalScrollBarVisibility="Auto"
                         AutomationProperties.Name="Madde notu yazma alanı" />
              </DockPanel>
            </Border>
          </Popup>
          <TextBlock Margin="0,14,0,0" TextWrapping="Wrap" Text="{Binding Status}"/>
          <TextBlock Margin="0,14,0,0" TextWrapping="Wrap"
                     Text="TUR004: Yeni not içeriği AES-256-GCM ile şifrelenir ve yedek doğrulanır; madde kimlikleri gibi üstveriler şifresizdir. TUR003 eski düz metin dosyaları korunur, silinmez. Fiziksel Windows kabulü henüz yapılmadı."/>
        </StackPanel>
      </DataTemplate>
      <DataTemplate DataType="{x:Type vm:PlaceholderViewModel}">
        <StackPanel>
          <TextBlock FontSize="21" FontWeight="Bold" Text="{Binding Title}"/>
          <TextBlock Margin="0,16,0,0" TextWrapping="Wrap" Text="{Binding Message}"/>
        </StackPanel>
      </DataTemplate>
    </ResourceDictionary>
  </Application.Resources>
</Application>
