                          </Border>
                        </DataTemplate>
                      </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <Border Background="{DynamicResource BackgroundBrush}" CornerRadius="8" Padding="14" Margin="0,12,0,15">
                      <StackPanel>
                        <TextBlock Text="{Binding FlowPosition}" FontWeight="Bold"/>
